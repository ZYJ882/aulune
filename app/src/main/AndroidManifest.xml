<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Aulune"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aulune">
        <activity
            android:name=".BilibiliLoginActivity"
            android:exported="false"
            android:label="登录" />
        <activity
            android:name=".BilibiliGeetestActivity"
            android:exported="false"
            android:label="验证码"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".BilibiliWebActivity"
            android:exported="false"
            android:label="账号管理" />
        <activity
            android:name=".MultiPlatformLoginActivity"
            android:exported="false"
            android:label="多平台账号管理" />
        <activity
            android:name=".PlatformWebLoginActivity"
            android:exported="false"
            android:label="平台登录"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
